<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="API Tests">

    <test name="Smoke Tests">
        <groups>
            <run>
                <include name="smoke"/> 
            </run>
        </groups>
        <classes>
            <class name="RestAssured.RestAssuredPOM.test.UserTest"/>
        </classes>
    </test>

    <test name="Sanity Tests">
        <groups>
            <run>
                <include name="sanity"/>
            </run>
        </groups>
        <classes>
            <class name="RestAssured.RestAssuredPOM.test.UserTest"/>
        </classes>
    </test>

</suite>
